<% identity = Rails.configuration.x.foundation %>
<% title "The Infinite Library" %>
<% description "Every hex address is a book. The Library of Babel, generated deterministically — nothing stored, everything reachable." %>

<section class="md-hero babel-hero" aria-labelledby="hero-title">
  <div class="md-hero__inner">
    <div>
      <p class="md-section__eyebrow"><%= identity[:application_name] %></p>
      <h1 id="hero-title">The library is total.</h1>
      <p>Every hex address is a book. A page of 4,100 characters is derived from the address alone — never stored, always the same. Every possible book exists; this is the door to all of them.</p>
      <div class="md-actions">
        <%= link_to "Open a random book", random_book_path, class: "md-button md-button--filled" %>
        <%= link_to "Search the library", search_books_path, class: "md-button md-button--outlined" %>
        <%= link_to "Read volume <%= @book.hex_short %>", book_path(@book.hex), class: "md-button md-button--tonal" %>
      </div>
    </div>
    <div class="md-hero__art" aria-hidden="true"><div class="md-hero__orb"></div></div>
  </div>
</section>

<section class="md-section" aria-labelledby="vault-title">
  <div class="md-section__inner">
    <p class="md-section__eyebrow">Volume <%= @book.hex_short %></p>
    <h2 id="vault-title" class="md-section__heading">A page, drawn from nothing.</h2>
    <p>This is the book at address <code><%= @book.hex %></code> — generated on demand, identical on every read.</p>
    <%= render "books/page", book: @book %>
  </div>
</section>

<section class="md-section md-section--tonal" aria-labelledby="capabilities-title">
  <div class="md-section__inner">
    <p class="md-section__eyebrow">In this build</p>
    <h2 id="capabilities-title" class="md-section__heading">What ships with this library.</h2>
    <div class="md-grid">
      <article class="md-card md-card--filled md-feature" data-capability="accounts">
        <span class="md-feature__number" aria-hidden="true"><%= material_symbol(:description, size: 32) %></span>
        <div>
          <h3>Every book, always</h3>
          <p>Any hex address is a valid volume. Pages are derived from the address alone and never stored, so the library is total and never runs out of shelf space.</p>
        </div>
      </article>
      <article class="md-card md-card--filled md-feature" data-capability="organizations">
        <span class="md-feature__number" aria-hidden="true"><%= material_symbol(:list, size: 32) %></span>
        <div>
          <h3>Navigable stacks</h3>
          <p>Each book has a previous and a next neighbor, plus a random door into the collection. Adjacent addresses are unrelated pages — every step is a discovery.</p>
        </div>
      </article>
      <article class="md-card md-card--filled md-feature" data-capability="billing">
        <span class="md-feature__number" aria-hidden="true"><%= material_symbol(:search, size: 32) %></span>
        <div>
          <h3>Deterministic search</h3>
          <p>A bounded scan regenerates pages on the fly to find the first book containing a phrase. Hits land on stable, shareable addresses — nothing is indexed, because everything is derivable.</p>
        </div>
      </article>
      <article class="md-card md-card--filled md-feature" data-capability="design">
        <span class="md-feature__number" aria-hidden="true"><%= material_symbol(:light_mode, size: 32) %></span>
        <div>
          <h3>Material Design 3</h3>
          <p>Light and dark tokens from one brand seed, adaptive navigation, and a local Material Symbols subset — no icon CDN and no Node build in production.</p>
        </div>
      </article>
      <article class="md-card md-card--filled md-feature" data-capability="security">
        <span class="md-feature__number" aria-hidden="true"><%= material_symbol(:task_alt, size: 32) %></span>
        <div>
          <h3>Hardened defaults</h3>
          <p>Host-header protection from the configured domain, deterministic content that needs no database, and health probes for database, queue, storage, and host headroom.</p>
        </div>
      </article>
      <article class="md-card md-card--filled md-feature" data-capability="native">
        <span class="md-feature__number" aria-hidden="true"><%= material_symbol(:open_in_new, size: 32) %></span>
        <div>
          <h3>Shareable addresses</h3>
          <p>Every book lives at one canonical URL. Open a neighbor, hit random, or share a locator — the same address always renders the same page, on any machine.</p>
        </div>
      </article>
    </div>
  </div>
</section>

<section class="md-section" aria-labelledby="plans-title">
  <div class="md-section__inner">
    <p class="md-section__eyebrow">The stacks</p>
    <h2 id="plans-title" class="md-section__heading">Start with what fits today.</h2>
    <div class="md-pricing-grid">
      <% PricingPlans.plans.each do |plan| %>
        <% cents = plan.metadata.dig(:prices, :month) %>
        <article class="md-card <%= plan.highlighted? ? "md-card--elevated" : "md-card--outlined" %> md-price-card">
          <% if plan.highlighted? %><span class="md-chip selected">Recommended</span><% end %>
          <h3><%= plan.name %></h3>
          <p><%= plan.description %></p>
          <p class="md-price-card__price"><%= cents.zero? ? "Free" : number_to_currency(cents / 100.0, precision: 0) %><%= "/month" unless cents.zero? %></p>
          <ul><% plan.bullets.first(3).each do |bullet| %><li><%= bullet %></li><% end %></ul>
          <%= link_to "View #{plan.name}", pricing_path, class: "md-button #{plan.highlighted? ? "md-button--filled" : "md-button--outlined"}" %>
        </article>
      <% end %>
    </div>
  </div>
</section>

<section class="md-section md-section--tonal" aria-labelledby="faq-title">
  <div class="md-section__inner">
    <p class="md-section__eyebrow">Questions, answered</p>
    <h2 id="faq-title" class="md-section__heading">A straightforward place to begin.</h2>
    <div class="md-faq">
      <details>
        <summary>Do I need an account to read?</summary>
        <p>No. The library is public: open any address, hit random, or search — no sign-in required.</p>
      </details>
      <details>
        <summary>Is anything stored?</summary>
        <p>No. A page is a pure function of its address. The same address always yields the same book, with no database row behind it.</p>
      </details>
      <details>
        <summary>Can I change plans later?</summary>
        <p>Yes. Eligible organizations can compare plans and manage an active subscription from billing, or contact sales when a plan is not self-serve.</p>
      </details>
      <details>
        <summary>How do I see where I am signed in?</summary>
        <p>Open Devices in settings to list live sessions, mark the current one, and revoke any session you do not recognize.</p>
      </details>
    </div>
  </div>
</section>
